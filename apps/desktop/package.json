{
  "name": "@deski/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:fake": "npm run build && electron . --fake-api",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs"
  },
  "devDependencies": {
    "@deski/api-types": "0.1.0",
    "@types/node": "22.20.5",
    "electron": "45.2.3",
    "typescript": "5.9.3"
  }
}
